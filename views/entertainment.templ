package views

templ EntertainmentPage() {
	@Layout("Entertainment", entertainmentBody())
}

templ entertainmentBody() {
	<h1>Entertainment</h1>
	<p>Grab your phone and join in — we're playing as a group.</p>
	<p>
		<a href="https://jackbox.tv" target="_blank" rel="noopener noreferrer" class="link-button">jackbox.tv</a>
	</p>
}
