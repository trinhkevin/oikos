// views/guestbook.templ
package views

import (
	"fmt"

	"homesite/internal/guestbook"
	"homesite/internal/photos"
)

type GuestbookFormError struct {
	Message  string
	Name     string
	Message_ string
}

// GuestbookEntryView pairs a guest book entry with its linked photo (if
// any) — guestbook.Store.List only returns the bare PhotoID, so the
// handler enriches it with a second lookup before rendering, the same
// way views/photos.templ's gallery renders Photo.Path/Photo.ThumbPath.
type GuestbookEntryView struct {
	Entry guestbook.Entry
	Photo *photos.Photo
}

templ GuestbookPage(entries []GuestbookEntryView) {
	@Layout("Guest Book", guestbookPageBody(entries, nil))
}

templ guestbookPageBody(entries []GuestbookEntryView, formErr *GuestbookFormError) {
	<h1>Guest Book</h1>
	@GuestbookForm(formErr)
	<div id="guestbook-rl-message"></div>
	<hr class="rule"/>
	<div id="guestbook-entries" class="guestbook-grid">
		@GuestbookEntries(entries)
	</div>
}

templ GuestbookForm(formErr *GuestbookFormError) {
	<form hx-post="/guestbook" hx-encoding="multipart/form-data" hx-target="#guestbook-entries" hx-swap="afterbegin" id="guestbook-form" hx-indicator="#guestbook-spinner">
		<label>
			Name
			<input type="text" name="name" maxlength="40" required
				if formErr != nil {
					value={ formErr.Name }
				}/>
		</label>
		<label>
			Message
			<textarea name="message" maxlength="500" required>
				if formErr != nil {
					{ formErr.Message_ }
				}
			</textarea>
		</label>
		<div class="guestbook-photo-field">
			<span class="field-caption">Photo (optional)</span>
			<div class="guestbook-photo-row">
				<label for="guestbook-photo-input" class="photo-upload-trigger photo-upload-trigger-sm" aria-label="Add a photo">
					<span aria-hidden="true">+</span>
				</label>
				<input type="file" id="guestbook-photo-input" name="photo" accept="image/jpeg,image/png,image/webp,image/heic" class="visually-hidden"/>
			</div>
		</div>
		if formErr != nil {
			<p class="form-error">{ formErr.Message }</p>
		}
		<div class="upload-controls">
			<button type="submit">Sign the guest book</button>
			<span id="guestbook-spinner" class="spinner htmx-indicator" aria-hidden="true"></span>
		</div>
	</form>
}

templ GuestbookEntries(entries []GuestbookEntryView) {
	for _, ev := range entries {
		<article class="guestbook-entry">
			if ev.Photo != nil {
				@PhotoLightbox(
					fmt.Sprintf("lightbox-guestbook-%d", ev.Photo.ID),
					"/uploads/"+ev.Photo.ThumbPath,
					"/uploads/"+ev.Photo.Path,
					"Guest book photo",
					"photo-frame guestbook-photo-frame",
					"guestbook-photo",
				)
			}
			<p class="guestbook-name">{ ev.Entry.Name }</p>
			<p class="guestbook-message">{ ev.Entry.Message }</p>
		</article>
	}
}
