package views

import "homesite/internal/content"

templ CatsIndex(cats []content.Cat) {
	@Layout("Meet the Cats", catsIndexBody(cats))
}

templ catsIndexBody(cats []content.Cat) {
	<h1>Meet the Cats</h1>
	<div class="cat-gallery">
		for i, cat := range cats {
			<div class="cat-entry">
				<div class="photo-frame">
					<img src={ "/media/" + cat.Photo } alt={ cat.Name } class="cat-thumb"/>
				</div>
				<span class="cat-caption">{ cat.Name }</span>
				<div class="prose">
					@templ.Raw(cat.BioHTML)
				</div>
				if cat.Birthday != "" {
					<p class="cat-meta"><strong>Birthday</strong> — { formatBirthday(cat.Birthday) }</p>
				}
				if len(cat.Likes) > 0 {
					<p class="cat-meta"><strong>Likes</strong> — { joinStrings(cat.Likes) }</p>
				}
				if len(cat.Dislikes) > 0 {
					<p class="cat-meta"><strong>Dislikes</strong> — { joinStrings(cat.Dislikes) }</p>
				}
				if len(cat.PetSpots) > 0 {
					<p class="cat-meta"><strong>Favorite spot to be pet</strong> — { joinStrings(cat.PetSpots) }</p>
				}
			</div>
			if i < len(cats)-1 {
				<hr class="rule"/>
			}
		}
	</div>
}
